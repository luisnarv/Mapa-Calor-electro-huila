# Conexión a PostgreSQL. Es la ÚNICA credencial del proyecto.
# psycopg2 acepta las dos formas; usa la que tenga tu entorno.
#
#   URI:
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE
#
#   Cadena de palabras clave de libpq (equivalente):
# DATABASE_URL=host=HOST port=5432 dbname=BASE user=USUARIO password=CLAVE

# Tabla de origen. Solo hay que definirla si cambia de nombre o de esquema.
# EH_TABLA=dbanalitica.historico_electrohuila

# Rutas (opcionales). Sin definirlas se usan las del proyecto:
#   EH_OUTPUT_DIR    -> web/public          (donde caen data.json y data_YYYY-MM.json)
#   EH_GEOJSON_DIR   -> web/public/geojson  (las capas ya preparadas)
#   EH_GEOGRAFIA_DIR -> ../Electro huila/Geografia/Helectro Huila
#                       (solo lo lee scripts/preparar_geografia.py, una vez)
# EH_OUTPUT_DIR=
# EH_GEOJSON_DIR=
# EH_GEOGRAFIA_DIR=

# Nivel de detalle de los logs del ETL.
EH_LOG_LEVEL=INFO
